# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin bootstrap passcode.
# If unset, use the first-run Admin setup form in the UI to claim the initial Admin account.
ADMIN_PASSCODE=
